/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'none'; script-src 'self' https://unpkg.com 'unsafe-inline'; style-src 'self' https://unpkg.com 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://server.arcgisonline.com https://geowebcache.ornith.cornell.edu; connect-src 'self' https://calbirds-atlas.pages.dev https://atlas.calbirds.org https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://server.arcgisonline.com https://geowebcache.ornith.cornell.edu; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
